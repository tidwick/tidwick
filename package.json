{
  "name": "tidwick",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": "github:tidwick/tidwick",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "HMAC key for stored token hashes and CSRF tokens. 32 random bytes, base64url without padding: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\\n'"
      },
      "NOTE_KEK": {
        "description": "Wraps each client's note key. 32 random bytes, standard base64: openssl rand -base64 32 | tr -d '\\n'. Losing it loses every note; keep a copy offline."
      },
      "BACKUP_RECIPIENT": {
        "description": "The age public key (age1...) the nightly backup is encrypted to. Make one with: age-keygen -o backup-key.txt; age-keygen -y backup-key.txt. Keep the identity file offline."
      }
    }
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/react": "7.1.9",
    "@fontsource-variable/geist": "5.3.0",
    "@simplewebauthn/server": "14.1.0",
    "@tailwindcss/vite": "4.3.5",
    "age-encryption": "0.3.1",
    "astro": "7.4.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.77.0",
    "oauth4webapi": "3.8.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "wrangler": "4.166.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "shadcn": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
