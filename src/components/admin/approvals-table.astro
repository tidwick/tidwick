---
import {
  Table,
  TableBody,
  TableCell,
  TableFooter,
  TableHead,
  TableHeader,
  TableRow,
  TableRowHead,
} from '../ui/table';
import type { ListedState, ListedWeek } from '../../db/approvals';
import { formatHours } from '../../lib/hours';
// The weeks of one state, by person: the name once with a subtotal when a person holds several, then each week
// with its date, hours and a link to open it (once the approver has confirmed with their passkey).
interface Props {
  weeks: ListedWeek[];
  /** How many weeks matched in all, which is more than `weeks` when the list was cut at a page. */
  found: number;
  state: ListedState;
  open: boolean;
}
const { weeks, found, state, open } = Astro.props;
const people = new Map<string, ListedWeek[]>();
for (const week of weeks) people.set(week.person_id, [...(people.get(week.person_id) ?? []), week]);
const sum = (rows: readonly ListedWeek[]) => rows.reduce((total, w) => total + w.total, 0);
const noun = (n: number) => (n === 1 ? '1 week' : `${String(n)} weeks`);
const day = (ms: number | null) =>
  ms === null ? 'not yet' : new Date(ms).toISOString().slice(0, 10);
const WHEN = {
  submitted: 'Submitted',
  approved: 'Approved',
  returned: 'Returned',
  draft: 'Submitted',
};
const cut = found > weeks.length;
---

<Table aria-label={`${WHEN[state]} weeks`}>
  <TableHeader>
    <TableRow>
      <TableHead>Person</TableHead>
      <TableHead>Week of</TableHead>
      <TableHead>{WHEN[state]}</TableHead>
      <TableHead className="text-right">Hours</TableHead>
      <TableHead>
        <span class="sr-only">Open</span>
      </TableHead>
    </TableRow>
  </TableHeader>
  <TableBody>
    {[...people.values()].flatMap((rows) =>
      rows.map((week, index) => (
        <TableRow className="max-md:grid-cols-[1fr_auto]">
          <TableRowHead className={`max-md:col-start-1 ${index === 0 ? '' : 'md:sr-only'}`}>
            {week.name}
            {week.offboarded === 1 && (
              <span class="block text-xs font-normal text-muted-foreground">Offboarded</span>
            )}
            {index === 0 && rows.length > 1 && (
              <span class="block text-xs font-normal text-muted-foreground">
                {noun(rows.length)}, {formatHours(sum(rows))} hours
              </span>
            )}
          </TableRowHead>
          <TableCell data-label="Week of" className="tabular-nums max-md:col-start-1">
            {week.week_start}
          </TableCell>
          <TableCell
            data-label={WHEN[state]}
            className="tabular-nums text-muted-foreground max-md:col-start-1"
          >
            {day(week.at)}
          </TableCell>
          <TableCell data-label="Hours" className="tabular-nums max-md:col-start-1 md:text-right">
            {formatHours(week.total)}
          </TableCell>
          <TableCell className="max-md:col-start-2 max-md:row-span-4 max-md:row-start-1 max-md:self-center md:text-right">
            {open ? (
              <a
                class="inline-flex h-9 items-center rounded-lg border border-control px-3 text-sm font-medium hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-md:h-11"
                href={`/approvals/${week.person_id}/${week.week_start}`}
                aria-label={`Open ${week.name}, week of ${week.week_start}`}
              >
                Open
              </a>
            ) : (
              <span class="text-xs text-muted-foreground">Confirm to open</span>
            )}
          </TableCell>
        </TableRow>
      )),
    )}
  </TableBody>
  <TableFooter>
    <TableRow>
      <TableRowHead colSpan={3}>
        {cut
          ? `First ${String(weeks.length)} of ${String(found)} weeks`
          : `All ${noun(weeks.length)}`}
        , {people.size === 1 ? '1 person' : `${String(people.size)} people`}
      </TableRowHead>
      <TableCell data-label="Hours" className="font-semibold tabular-nums md:text-right">
        {formatHours(sum(weeks))}
      </TableCell>
      <TableCell />
    </TableRow>
  </TableFooter>
</Table>
