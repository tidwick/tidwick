---
import { Textarea } from '../ui/textarea';
import { nextId } from './ids';
// A JSON document in a textarea, with the schema's complaints listed under it and tied to it. The `hint` slot
// says what the document holds.
interface Props {
  label: string;
  field: string;
  value: string;
  rows: number;
  errors?: readonly string[];
}
const { label, field, value, rows, errors = [] } = Astro.props;
const id = nextId(`f-${field}`);
const described = [`${id}-hint`, errors.length > 0 ? `${id}-err` : ''].filter(Boolean).join(' ');
---

<div class="grid gap-1.5">
  <label for={id} class="text-sm font-medium">
    {label}
  </label>
  <Textarea
    id={id}
    name={field}
    rows={rows}
    required
    spellCheck={false}
    aria-invalid={errors.length > 0 ? true : undefined}
    aria-describedby={described}
    className="border-control font-mono text-sm"
    defaultValue={value}
  />
  <p id={`${id}-hint`} class="text-xs text-muted-foreground">
    <slot />
  </p>
  {errors.length > 0 && (
    <ul id={`${id}-err`} class="grid gap-1 text-sm font-medium text-danger">
      {errors.map((message) => (
        <li>{message}</li>
      ))}
    </ul>
  )}
</div>
