---
import { actions } from 'astro:actions';
import { ASSIGN_ALL_MAX } from '../../db/assignments';
import type { AssignableProject, PersonAssignment } from '../../db/people-access';
import { Badge } from '../ui/badge';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
  TableRowHead,
} from '../ui/table';
import Empty from './empty.astro';
import PostForm from './post-form.astro';
import SelectField from './select-field.astro';
// The projects a person is assigned to, each removable, and for an active person an assign select and the one-click
// assignment to every live project.
interface Props {
  csrf: string;
  person: { id: string; name: string };
  assigned: PersonAssignment[];
  /** Live projects the person is not on. */
  assignable: AssignableProject[];
  active: boolean;
}
const { csrf, person, assigned, assignable, active } = Astro.props;
const day = (ms: number) => new Date(ms).toISOString().slice(0, 10);
---

<section aria-labelledby="assign-h" class="grid gap-3">
  <h2 id="assign-h" class="text-lg font-semibold">
    Assignments
  </h2>
  {assigned.length === 0 ? (
    <Empty title="Not assigned to any project">
      Open a project and assign {person.name} there. A member sees only the projects they are
      assigned to.
    </Empty>
  ) : (
    <Table aria-label={`Projects ${person.name} is assigned to`}>
      <TableHeader>
        <TableRow>
          <TableHead>Project</TableHead>
          <TableHead>Client</TableHead>
          <TableHead>Assigned</TableHead>
          <TableHead>
            <span class="sr-only">Actions</span>
          </TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        {assigned.map((a) => (
          <TableRow>
            <TableRowHead>
              <a class="underline underline-offset-2" href={`/projects/${a.project_id}`}>
                {a.project}
              </a>
              {a.number && (
                <span class="ml-2 text-xs font-normal tabular-nums text-muted-foreground">
                  {a.number}
                </span>
              )}
              {a.archived === 1 && (
                <Badge variant="secondary" className="ml-2">
                  Archived
                </Badge>
              )}
            </TableRowHead>
            <TableCell data-label="Client">{a.client}</TableCell>
            <TableCell data-label="Assigned" className="tabular-nums text-muted-foreground">
              {day(a.assigned_at)}
            </TableCell>
            <TableCell className="md:text-right">
              <PostForm
                compact
                action={actions.assignments.remove}
                csrf={csrf}
                label="Remove"
                named={`Remove ${person.name} from ${a.project}`}
                tone="plain"
                fields={{ projectId: a.project_id, personId: person.id }}
              />
            </TableCell>
          </TableRow>
        ))}
      </TableBody>
    </Table>
  )}
  {active && assignable.length > 0 && (
    <div class="max-w-md rounded-lg border border-border p-4">
      <PostForm
        action={actions.assignments.add}
        csrf={csrf}
        label="Assign"
        fields={{ personId: person.id }}
      >
        <SelectField
          label="Project"
          field="projectId"
          required
          options={assignable.map((p) => ({ value: p.id, label: `${p.client}: ${p.project}` }))}
        />
      </PostForm>
    </div>
  )}
  {active && (
    <PostForm
      action={actions.assignments.addAll}
      csrf={csrf}
      label="Assign to all live projects"
      tone="plain"
      fields={{ personId: person.id }}
    >
      <p class="text-sm text-muted-foreground">
        One press adds up to {ASSIGN_ALL_MAX} projects; press again while projects remain to assign.
      </p>
    </PostForm>
  )}
</section>
