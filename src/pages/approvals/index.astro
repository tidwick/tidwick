---
import ApprovalsFilter from '../../components/admin/approvals-filter.astro';
import ApprovalsTable from '../../components/admin/approvals-table.astro';
import Empty from '../../components/admin/empty.astro';
import NotSubmitted from '../../components/admin/not-submitted.astro';
import SearchForm from '../../components/admin/search-form.astro';
import Shell from '../../components/admin/shell.astro';
import StepUp from '../../components/admin/step-up.astro';
import { approvalWeeks, LISTED_STATES, type ListedState } from '../../db/approvals';
import { notSubmittedWeeks } from '../../db/not-submitted';
import { currentEnv } from '../../lib/env';
import { timeZone } from '../../db/settings';
import { searchTerm } from '../../lib/search';
import { todayIn, weekStartOf } from '../../lib/week';
import { completedWeeks, weekEndsAt } from '../../lib/week-end';
import { pageContext } from '../_context';

const LOOKS_BACK = 4;
const ctx = pageContext(Astro);
const query = Astro.url.searchParams;
const term = searchTerm(query.get('q'));
const asked = query.get('state') ?? '';
const state = LISTED_STATES.find((s): s is ListedState => s === asked) ?? 'submitted';
const monday = (name: string) => weekStartOf(query.get(name) ?? '') ?? '';
const [from, to] = [monday('from'), monday('to')];
const pageRows = currentEnv().POLICY.approvalsPage;
const { weeks, found } = await approvalWeeks(
  ctx.scope,
  ctx.db,
  { state, term, from: from === '' ? null : from, to: to === '' ? null : to },
  pageRows,
);
const zone = await timeZone(ctx.db);
const missing =
  state === 'submitted'
    ? await notSubmittedWeeks(
        ctx.scope,
        ctx.db,
        completedWeeks(todayIn(zone, Date.now()), LOOKS_BACK).map((weekStart) => ({
          weekStart,
          endsAt: weekEndsAt(weekStart, zone),
        })),
        pageRows,
        term,
      )
    : null;
const open = ctx.stepUpUntil !== null;
const people = new Set(weeks.map((w) => w.person_id)).size;
const keep = { state, from, to };
const NAME = {
  submitted: 'waiting',
  approved: 'approved',
  returned: 'returned',
  draft: 'unsubmitted',
};
const filtered = term !== '' || from !== '' || to !== '';
const status = `${found === 1 ? '1 week' : `${String(found)} weeks`} from ${people === 1 ? '1 person' : `${String(people)} people`}${term === '' ? '' : ` ${found === 1 ? 'matches' : 'match'} “${term}”`}.`;
---

<Shell title="Approvals">
  <Fragment slot="lead">
    Weeks people have submitted, one line each. Open one to read it, approve it, return it, or edit
    it through the lock. The other lists reach approved, returned and unsubmitted weeks.
  </Fragment>

  <StepUp
    csrf={ctx.csrf}
    until={ctx.stepUpUntil}
    unlocks="opening a week, approving, returning and editing"
  />

  <ApprovalsFilter state={state} term={term} from={from} to={to} />

  {(weeks.length > 0 || filtered) && (
    <SearchForm
      action="/approvals"
      label="Search people"
      term={term}
      hint="Name, email or code"
      status={status}
      keep={Object.fromEntries(Object.entries(keep).filter(([, value]) => value !== ''))}
    />
  )}

  {weeks.length === 0 && filtered ? (
    <Empty title={`No ${NAME[state]} week matches that search`}>
      Try part of a name, an email or an accounting code, or widen the weeks, or clear the search.
    </Empty>
  ) : weeks.length === 0 && state === 'submitted' ? (
    <Empty title="No weeks are waiting for approval">
      People submit a week from their Week page. It appears here, with its total, as soon as they
      do.
    </Empty>
  ) : weeks.length === 0 ? (
    <Empty title={`No ${NAME[state]} weeks`}>Weeks in this state appear here.</Empty>
  ) : (
    <ApprovalsTable weeks={weeks} found={found} state={state} open={open} />
  )}

  {missing && <NotSubmitted list={missing} open={open} looksBack={LOOKS_BACK} />}
</Shell>
