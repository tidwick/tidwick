---
import { actions } from 'astro:actions';
import Heading from '../components/auth/heading.astro';
import { DANGER, PRIMARY, SECONDARY } from '../components/auth/classes';
import SsoLinks from '../components/auth/sso-links.astro';
import { confirmLinks } from '../components/auth/sso-links';
import Status from '../components/auth/status.astro';
import CodesStep from '../components/passkey/codes-step.astro';
import SavedLine from '../components/saved-line.astro';
import SignOutForm from '../components/sign-out-form.astro';
import { Alert } from '../components/ui/alert';
import { STEP_UP_MS } from '../auth/step-up';
import { listedCredentialsOf } from '../db/credentials';
import { liveIdentitiesOf } from '../db/identities';
import { unusedCodeCount } from '../db/recovery-codes';
import { clockUtc } from '../lib/dates';
import { currentEnv } from '../lib/env';
import { cn } from 'cn';
import AccountFrame from '../components/admin/account-frame.astro';
import { pageContext, problemOf, savedAt, succeeded } from './_context';

const session = Astro.locals.session;
if (!session) return Astro.redirect('/login');
const ctx = pageContext(Astro);
const renewed = Astro.getActionResult(actions.auth.regenerateCodes);
const posted = [
  Astro.getActionResult(actions.auth.revokePasskey),
  Astro.getActionResult(actions.auth.logoutOthers),
];
if (succeeded(posted)) return Astro.redirect(savedAt('/account'), 303);
const problem = problemOf([...posted, renewed]);
const newCodes = renewed?.data?.codes ?? [];
const codesLeft = await unusedCodeCount(ctx.db, session.personId);
const passkeys = await listedCredentialsOf(ctx.db, session.personId);
const identities = await liveIdentitiesOf(ctx.db, session.personId);
const sso = await confirmLinks(session.personId, '/account');
// A last passkey can go while another way in remains; the server also keeps one admin with a passkey.
const spare = passkeys.length > 1 || identities.length > 0;
const providerLabel = (id: string) => currentEnv().SSO.find((p) => p.id === id)?.label ?? id;
const day = (ms: number) => new Date(ms).toISOString().slice(0, 10);
const confirmed = session.stepUpAt + STEP_UP_MS > Date.now();
const recovery = session.mustEnrol;
// One size of button on the page; only adding a passkey is primary.
const ADD = cn(PRIMARY, 'w-fit');
const CONFIRM = cn(SECONDARY, 'w-fit');
---

<AccountFrame
  recovery={recovery}
  title="Your account"
  problem={problem}
  lead={`Signed in as ${session.name}.`}
>
  <div class="grid max-w-xl gap-section" data-enrol-start>
    {recovery && (
      <section>
        <Heading text="Your account">Signed in as {session.name}.</Heading>
        <Alert variant="notice" role="status" className="mt-4">
          You signed in with a recovery code. Add a passkey to finish.
        </Alert>
        <SavedLine problem={problem} />
        {problem && (
          <Alert variant="danger" className="mt-4 font-medium">
            {problem}
          </Alert>
        )}
      </section>
    )}

    <section aria-labelledby="passkeys-h" class="grid gap-3">
      <h2 id="passkeys-h" class="text-lg font-semibold">
        Your passkeys
      </h2>
      <ul class="divide-y divide-border rounded-md border border-border">
        {passkeys.length === 0 && (
          <li class="p-4 text-sm text-muted-foreground">No passkeys yet.</li>
        )}
        {passkeys.map((p, i) => (
          <li class="flex flex-wrap items-center justify-between gap-3 p-4">
            <div class="text-sm">
              <p class="font-medium">
                Passkey {i + 1}, added {day(p.created_at)}
              </p>
              <p class="text-muted-foreground">
                {p.last_used_at === null
                  ? 'Never used to sign in'
                  : `Last used ${day(p.last_used_at)}`}
              </p>
            </div>
            {!session.mustEnrol && spare && (
              <form method="POST" action={`/account${actions.auth.revokePasskey}`}>
                <input type="hidden" name="_csrf" value={ctx.csrf} />
                <input type="hidden" name="id" value={p.id} />
                <button type="submit" class={DANGER}>
                  Remove
                </button>
              </form>
            )}
            {!spare && <p class="text-sm text-muted-foreground">Your only passkey</p>}
          </li>
        ))}
      </ul>
      {!spare && passkeys.length === 1 && (
        <p class="text-sm text-muted-foreground">
          Your only passkey cannot be removed. Add another first.
        </p>
      )}
      {!session.mustEnrol && spare && passkeys.length > 0 && (
        <p data-remove-note class="text-sm text-muted-foreground">
          Removing a passkey does not sign out a browser already signed in with it. Use Sign out
          other sessions below for browsers.
        </p>
      )}
      <button type="button" data-passkey="add" data-csrf={ctx.csrf} class={ADD}>
        Add a passkey
      </button>
      <Status />
      <p class="rounded-md border border-border p-3 text-sm text-muted-foreground">
        If you lose every passkey and every recovery code, an admin has to re-enrol you.
        Re-enrolment revokes all your passkeys, recovery codes and sessions, and gives you a new
        single-use link to start again.
      </p>
    </section>

    {identities.length > 0 && (
      <section aria-labelledby="linked-h" class="grid gap-3">
        <h2 id="linked-h" class="text-lg font-semibold">
          Linked sign-ins
        </h2>
        <ul class="divide-y divide-border rounded-md border border-border">
          {identities.map((i) => (
            <li class="p-4 text-sm">
              <p class="font-medium">{providerLabel(i.provider)}</p>
              <p class="text-muted-foreground">
                {i.email ?? 'No email on file'}
                {' · '}
                {i.last_used_at === null
                  ? 'Never used to sign in'
                  : `Last used ${day(i.last_used_at)}`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {!session.mustEnrol && (
      <section aria-labelledby="confirm-h" class="grid gap-3">
        <h2 id="confirm-h" class="text-lg font-semibold">
          Confirm for sensitive changes
        </h2>
        <p class="text-sm text-muted-foreground">
          {confirmed
            ? `Confirmed until ${clockUtc(session.stepUpAt + STEP_UP_MS)} UTC.`
            : 'Removing a passkey, making new recovery codes and similar changes need a confirmation from the last 15 minutes.'}
        </p>
        {passkeys.length > 0 && (
          <button type="button" data-passkey="step-up" data-csrf={ctx.csrf} class={CONFIRM}>
            Confirm with your passkey
          </button>
        )}
        <div class="max-w-sm">
          <SsoLinks links={sso} />
        </div>
        {passkeys.length === 0 && sso.length === 0 && (
          <p class="text-sm text-muted-foreground">
            Your sign-in provider cannot confirm again here. Add a passkey to make sensitive
            changes.
          </p>
        )}
      </section>
    )}

    {!session.mustEnrol && (
      <section aria-labelledby="codes-h" class="grid gap-3">
        <h2 id="codes-h" class="text-lg font-semibold">
          Recovery codes
        </h2>
        {newCodes.length > 0 ? (
          <>
            <p class="text-sm text-muted-foreground">
              Your old codes no longer work. Keep these ten somewhere safe; they are shown only
              once.
            </p>
            <ol class="grid gap-2 rounded-md sm:grid-cols-2 border border-border p-4 font-mono text-sm">
              {newCodes.map((code) => (
                <li data-code>{code}</li>
              ))}
            </ol>
          </>
        ) : (
          <p class="text-sm text-muted-foreground">
            {codesLeft === 1 ? '1 unused code left.' : `${String(codesLeft)} unused codes left.`}{' '}
            Making new codes retires every old one, and does not sign out a browser already signed
            in with one; Sign out other sessions below does that.
          </p>
        )}
        <form method="POST" action={`/account${actions.auth.regenerateCodes}`}>
          <input type="hidden" name="_csrf" value={ctx.csrf} />
          <button type="submit" data-passkey="regen" data-csrf={ctx.csrf} class={SECONDARY}>
            Make new recovery codes
          </button>
        </form>
        {!confirmed && <p class="text-sm text-muted-foreground">Confirm above first.</p>}
      </section>
    )}

    {!session.mustEnrol && (
      <section aria-labelledby="sessions-h" class="grid gap-3">
        <h2 id="sessions-h" class="text-lg font-semibold">
          Other sessions
        </h2>
        <p class="text-sm text-muted-foreground">
          Sign out every other browser and device. This one stays signed in.
        </p>
        <form method="POST" action={`/account${actions.auth.logoutOthers}`}>
          <input type="hidden" name="_csrf" value={ctx.csrf} />
          <button type="submit" class={DANGER}>
            Sign out other sessions
          </button>
        </form>
      </section>
    )}

    {recovery && <SignOutForm />}
  </div>
  <CodesStep next="/account" />
</AccountFrame>

<script>
  import { wireAddPasskey, wireRegenerate, wireStepUp } from '../components/passkey/ceremony';
  wireAddPasskey();
  wireStepUp();
  wireRegenerate();
</script>
