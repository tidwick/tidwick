---
import { actions, isInputError } from 'astro:actions';
import Heading from '../components/auth/heading.astro';
import { LINK, PRIMARY } from '../components/auth/classes';
import { Alert } from '../components/ui/alert';
import { Input } from '../components/ui/input';
import Auth from '../layouts/auth.astro';

const result = Astro.getActionResult(actions.auth.recover);
if (result && !result.error) return Astro.redirect(result.data.next);
const problem = result?.error
  ? isInputError(result.error)
    ? 'Enter your email and one recovery code.'
    : result.error.message
  : '';
---

<Auth title="Recover your account">
  <section>
    <Heading text="Use a recovery code">
      A code signs you in only to set up a new passkey. Each code works once.
    </Heading>
    {problem && (
      <Alert id="recover-problem" variant="danger" className="mt-4 font-medium">
        {problem}
      </Alert>
    )}
    <form method="POST" action={actions.auth.recover} class="mt-6 grid gap-4">
      <input type="hidden" name="_csrf" value={Astro.locals.csrf} />
      <label class="grid gap-1 text-sm font-medium">
        Email
        <Input
          name="email"
          type="email"
          autoComplete="username"
          required
          aria-describedby={problem ? 'recover-problem' : undefined}
          className="min-h-11"
        />
      </label>
      <label class="grid gap-1 text-sm font-medium">
        Recovery code
        <Input
          name="code"
          autoComplete="one-time-code"
          autoCapitalize="characters"
          spellCheck={false}
          required
          aria-describedby={problem ? 'recover-problem' : undefined}
          className="min-h-11 font-mono"
        />
      </label>
      <button type="submit" class={PRIMARY}>
        Continue
      </button>
    </form>
  </section>
  <p class="text-sm">
    <a class={LINK} href="/login">
      Back to sign in
    </a>
  </p>
</Auth>
