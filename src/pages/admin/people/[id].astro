---
import { actions } from 'astro:actions';
import AccessBadge from '../../../components/admin/access-badge.astro';
import Assignments from '../../../components/admin/person-assignments.astro';
import PersonConfirm from '../../../components/admin/person-confirm.astro';
import PersonEdit from '../../../components/admin/person-edit.astro';
import PostForm from '../../../components/admin/post-form.astro';
import SignInMethods from '../../../components/admin/sign-in-methods.astro';
import Shell from '../../../components/admin/shell.astro';
import StepUp from '../../../components/admin/step-up.astro';
import { Badge } from '../../../components/ui/badge';
import { buttonVariants } from '../../../components/ui/button';
import { listFirms } from '../../../db/firms';
import { liveIdentitiesOf } from '../../../db/identities';
import { accessByPerson, assignmentsOf } from '../../../db/people-access';
import { GRANTS } from '../../../db/roles';
import { personDetail } from '../../../db/people';
import { errorPage } from '../../../middleware/error-responses';
import {
  fieldErrors,
  pageContext,
  postedFields,
  problemOf,
  savedAt,
  succeeded,
} from '../../_context';

const ctx = pageContext(Astro);
const id = Astro.params.id ?? '';
const issued = Astro.getActionResult(actions.people.issueEnrolment);
const reissued = Astro.getActionResult(actions.people.reenrol);
const unlocked = Astro.getActionResult(actions.people.unlock);
const roles = Astro.getActionResult(actions.people.setRoles);
const all = Astro.getActionResult(actions.assignments.addAll);
const offboarded = Astro.getActionResult(actions.people.offboard);
const updated = Astro.getActionResult(actions.people.update);
const reinstated = Astro.getActionResult(actions.people.reinstate);
const unlinked = Astro.getActionResult(actions.people.unlinkSso);
if (succeeded([offboarded])) return Astro.redirect(savedAt('/admin/people'), 303);
if (succeeded([roles, all, unlinked, updated, reinstated]))
  return Astro.redirect(savedAt(Astro.url.pathname), 303);
const person = await personDetail(ctx.scope, ctx.db, id);
if (!person) return errorPage(Astro, 'not_found');
const held = new Set(person.roles.split(','));
const link = issued?.data?.link ?? reissued?.data?.link ?? null;
const active = person.offboarded_at === null;
const access = (await accessByPerson(ctx.db, Date.now())).get(id) ?? {
  passkeys: 0,
  sso: 0,
  openLinks: 0,
};
const assigned = await assignmentsOf(ctx.scope, ctx.db, id);
const identities = await liveIdentitiesOf(ctx.db, id);
const firms = await listFirms(ctx.db);
const typed = updated?.error ? await postedFields(Astro) : null;
const asked = Astro.url.searchParams.get('confirm');
const confirm = active && (asked === 'offboard' || asked === 'reenrol') ? asked : null;
const confirmLink = (danger = false) =>
  `${buttonVariants({ variant: 'outline', size: 'lg' })} justify-self-start max-md:h-11 max-md:px-4 max-md:text-sm ${danger ? 'border-danger text-danger hover:bg-danger-surface hover:text-danger' : 'border-control'}`;
---

<Shell
  title={person.name}
  problem={problemOf([
    issued,
    reissued,
    unlocked,
    roles,
    offboarded,
    all,
    unlinked,
    updated,
    reinstated,
  ])}
>
  <Fragment slot="lead">
    <a class="underline underline-offset-2" href="/admin/people">
      All people
    </a>
  </Fragment>

  <dl class="grid gap-x-8 gap-y-3 rounded-lg border border-border p-4 text-sm sm:grid-cols-2 lg:grid-cols-[max-content_1fr_1fr_1fr]">
    <div>
      <dt class="text-muted-foreground">Email</dt>
      <dd class="break-words">{person.email}</dd>
    </div>
    <div>
      <dt class="text-muted-foreground">Firm</dt>
      <dd>{person.firm_name}</dd>
    </div>
    <div>
      <dt class="text-muted-foreground">Accounting code</dt>
      <dd>{person.external_code ?? 'None'}</dd>
    </div>
    <div>
      <dt class="text-muted-foreground">Access</dt>
      <dd class="flex flex-wrap gap-1">
        <AccessBadge access={access} offboarded={!active} />
        {active && access.openLinks > 0 && access.passkeys > 0 && (
          <Badge variant="outline">Link waiting</Badge>
        )}
      </dd>
    </div>
  </dl>

  {link && (
    <section
      aria-labelledby="link-h"
      class="rounded-lg border border-control bg-muted/40 p-4 text-sm"
    >
      <h2 id="link-h" class="font-semibold">
        Enrolment link, shown once
      </h2>
      <p class="mt-1 text-muted-foreground">
        It works for 24 hours and one use. Send it to {person.name} yourself.
      </p>
      <p class="mt-2 break-all rounded-md bg-background p-2 font-mono" data-enrolment-link>
        {link}
      </p>
    </section>
  )}
  {unlocked?.data && (
    <p role="status" class="rounded-md bg-muted p-3 text-sm">
      {unlocked.data.wasLocked ? 'Recovery is unlocked.' : 'There was nothing to unlock.'}
    </p>
  )}

  <Assignments csrf={ctx.csrf} person={person} assigned={assigned} active={active} />

  <StepUp
    csrf={ctx.csrf}
    until={ctx.stepUpUntil}
    unlocks={active ? 'access changes, roles, email changes and offboarding' : 'reinstating'}
  />

  {confirm && <PersonConfirm csrf={ctx.csrf} person={person} kind={confirm} />}

  {!active && (
    <section aria-labelledby="back-h" class="grid max-w-md gap-3">
      <h2 id="back-h" class="text-lg font-semibold">
        Reinstate
      </h2>
      <p class="text-sm text-muted-foreground">
        Lifts the offboarding. They have no access until you issue an enrolment link and they enrol
        a new passkey.
      </p>
      <PostForm
        action={actions.people.reinstate}
        csrf={ctx.csrf}
        label="Reinstate"
        tone="plain"
        fields={{ id: person.id }}
      />
    </section>
  )}

  {active && (
    <>
      <PersonEdit
        csrf={ctx.csrf}
        person={person}
        firms={firms}
        typed={typed}
        errors={fieldErrors([updated])}
      />

      <section aria-labelledby="access-h" class="grid gap-3">
        <h2 id="access-h" class="text-lg font-semibold">
          Access
        </h2>
        <p class="text-sm text-muted-foreground">
          An enrolment link lets the person create their first passkey. Re-enrolling revokes every
          passkey, recovery code and session first.
        </p>
        <div class="flex flex-wrap gap-3">
          <PostForm
            action={actions.people.issueEnrolment}
            csrf={ctx.csrf}
            label="Issue enrolment link"
            tone="plain"
            fields={{ id: person.id }}
          />
          <a class={confirmLink()} href="?confirm=reenrol#confirm">
            Re-enrol (revokes everything)
          </a>
          <PostForm
            action={actions.people.unlock}
            csrf={ctx.csrf}
            label="Unlock recovery"
            tone="plain"
            fields={{ id: person.id }}
          />
        </div>
      </section>

      <SignInMethods
        csrf={ctx.csrf}
        person={person}
        passkeys={access.passkeys}
        identities={identities}
      />

      <section aria-labelledby="roles-h" class="grid max-w-md gap-3">
        <h2 id="roles-h" class="text-lg font-semibold">
          Roles
        </h2>
        <p class="text-sm text-muted-foreground">Everyone is a member. These are extra.</p>
        <PostForm
          action={actions.people.setRoles}
          csrf={ctx.csrf}
          label="Save roles"
          fields={{ id: person.id }}
        >
          <fieldset class="grid gap-2">
            <legend class="sr-only">Roles</legend>
            {GRANTS.map((grant) => (
              <label class="flex min-h-11 items-center gap-3 text-sm">
                <input
                  type="checkbox"
                  name="grants"
                  value={grant}
                  checked={held.has(grant)}
                  class="size-5"
                />
                {grant.replaceAll('_', ' ')}
              </label>
            ))}
          </fieldset>
        </PostForm>
      </section>

      <section aria-labelledby="off-h" class="grid max-w-md gap-3">
        <h2 id="off-h" class="text-lg font-semibold">
          Offboard
        </h2>
        <p class="text-sm text-muted-foreground">
          Ends every session and passkey and closes every open link. Their time stays.
        </p>
        <a class={confirmLink(true)} href="?confirm=offboard#confirm">
          Offboard
        </a>
      </section>
    </>
  )}
</Shell>
