---
import { actions } from 'astro:actions';
import Heading from '../components/auth/heading.astro';
import { SECONDARY } from '../components/auth/classes';
import Auth from '../layouts/auth.astro';
import { demoOpen } from '../auth/demo';
import { DEMO_PERSONAS } from '../lib/demo-personas';
import { currentEnv } from '../lib/env';

// The demo's entry: pick a person and you are in. With any of its three signals missing this is a route that does not exist.
if (!(await demoOpen(currentEnv()))) return new Response(null, { status: 404 });
const result = Astro.getActionResult(actions.auth.demoSignin);
if (result && !result.error) return Astro.redirect(result.data.next);
---

<Auth title="Try the demo">
  <section>
    <Heading text="Try the demo">
      Pick a person to be. The people and their time are invented, a session lasts two hours and
      asks for no passkey, and everything is reset overnight.
    </Heading>
    <form method="POST" action={actions.auth.demoSignin} class="mt-6 grid gap-4">
      <input type="hidden" name="_csrf" value={Astro.locals.csrf} />
      <p class="text-sm font-medium">Sign in as</p>
      {DEMO_PERSONAS.map((p) => (
        <button
          type="submit"
          name="persona"
          value={p.key}
          class={`${SECONDARY} h-auto w-full min-w-0 justify-start py-2`}
        >
          <span class="grid min-w-0 text-left leading-tight whitespace-normal">
            <span>{p.name}</span>
            <span class="text-sm font-normal">{p.role}</span>
            <span class="text-sm font-normal text-muted-foreground">{p.tryIt}</span>
          </span>
        </button>
      ))}
    </form>
  </section>
</Auth>
