---
// The shell for the pages a stranger meets first: a quiet header, one narrow column on a card, one spacing scale.
import { Card, CardContent } from '../components/ui/card';
import { ThemeToggle } from '../components/theme-toggle';
import Base from './base.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Base title={`${title} · tidwick`}>
  <header class="border-b border-border print:hidden">
    <div class="mx-auto flex max-w-md items-center justify-between px-gutter py-field">
      <a
        href="/"
        class="rounded-md text-lg font-semibold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        tidwick
      </a>
      <ThemeToggle />
    </div>
  </header>
  <main id="main" class="mx-auto grid max-w-md gap-block px-gutter py-section sm:py-page">
    <Card>
      <CardContent className="grid gap-block">
        <slot />
      </CardContent>
    </Card>
  </main>
</Base>
