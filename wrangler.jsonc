{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidwick",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "ORIGIN": "http://localhost:4321",
    "RP_ID": "localhost",
    "MAIL": "on",
    "MAIL_FROM": "tidwick@example.com",
    "BACKUP_COPY": "s3",
    "BACKUP_S3_REGION": "auto",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": [
      "/*",
      "!/@vite/*",
      "!/@id/*",
      "!/@fs/*",
      "!/@react-refresh",
      "!/src/*",
      "!/node_modules/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidwick",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "tidwick-backups" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
  ],
  "triggers": { "crons": ["0 3 * * *", "0 9 * * *"] },
  "env": {
    "demo": {
      "name": "tidwick-demo",
      "routes": [{ "pattern": "demo.tidwick.dev", "custom_domain": true }],
      "vars": {
        "ORIGIN": "https://demo.tidwick.dev",
        "RP_ID": "demo.tidwick.dev",
        "MAIL": "off",
        "DEMO_BANNER": "on",
        "DEMO_LOGIN": "on",
        "BACKUP_COPY": "none",
      },
      "triggers": { "crons": ["0 4 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tidwick-db",
          "database_id": "REPLACE_WITH_DEMO_D1_DATABASE_ID",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        { "name": "RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "LOGIN_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
      ],
    },
  },
}
