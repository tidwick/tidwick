{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidwick",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Policy knobs, all optional, each a plain var below (a number, or for AGENT_TOKEN_DAYS a string such as "7,30"):
  // unset is the default. The same table, with what each governs, is in docs/ARCHITECTURE.md, Policy knobs.
  // AGENT_TOKEN_DAYS 7,30,90 (1 to 6 lives, each 1 to 365)
  // AGENT_TOKEN_MAX 5 (1 to 50)
  // AGENT_TOKEN_DEFAULT_DAYS 30 (1 to 365)
  // MCP_ACCESS_MINUTES 60 (5 to 1440)
  // MCP_REFRESH_DAYS 30 (1 to 90)
  // MCP_GRANT_DAYS 90 (1 to 365)
  // SESSION_IDLE_HOURS 8 (1 to 72)
  // SESSION_MAX_DAYS 14 (1 to 90)
  // STEP_UP_MINUTES 15 (1 to 15)
  // ENROLMENT_HOURS 24 (1 to 168)
  // PENDING_CODES_MINUTES 10 (1 to 60)
  // AUDIT_PAGE_ROWS 50 (10 to 500)
  // APPROVALS_PAGE_ROWS 500 (50 to 2000)
  // NOT_SUBMITTED_WEEKS 4 (1 to 12)
  // REPORT_MAX_DAYS 366 (31 to 1830)
  // REPORT_MAX_BARS 40 (5 to 100)
  // IMPORT_MAX_ROWS 5000 (100 to 10000)
  // IMPORT_MAX_NEW 50 (1 to 100)
  // BACKUP_TRIES 3 (1 to 6)
  // BACKUP_RETRY_SECONDS 2 (0 to 30)
  // BACKUP_KEEP_DAYS 40 (1 to 400)
  "vars": {
    "ORIGIN": "http://localhost:4321",
    "RP_ID": "localhost",
    "MAIL": "on",
    "MAIL_FROM": "tidwick@example.com",
    "BACKUP_COPY": "s3",
    "BACKUP_S3_REGION": "auto",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": [
      "/*",
      "!/@vite/*",
      "!/@id/*",
      "!/@fs/*",
      "!/@react-refresh",
      "!/src/*",
      "!/node_modules/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tidwick",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "tidwick-backups" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LOGIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
  ],
  "triggers": { "crons": ["0 3 * * *", "0 9 * * *"] },
  "env": {
    "demo": {
      "name": "tidwick-demo",
      "workers_dev": false,
      "routes": [{ "pattern": "demo.tidwick.dev", "custom_domain": true }],
      "vars": {
        "ORIGIN": "https://demo.tidwick.dev",
        "RP_ID": "demo.tidwick.dev",
        "MAIL": "off",
        "DEMO_BANNER": "on",
        "DEMO_LOGIN": "on",
        "BACKUP_COPY": "none",
      },
      "triggers": { "crons": ["0 4 * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tidwick-db",
          "database_id": "9e8617c3-7f69-463e-b66a-c85670cb8bc9",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        { "name": "RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
        { "name": "LOGIN_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } },
      ],
    },
  },
}
