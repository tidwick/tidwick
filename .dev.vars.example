# Copy to .dev.vars for local dev and fill each value; never commit .dev.vars. Names only here, no values.
# SESSION_SECRET: HMAC key for stored token hashes and CSRF tokens; 32 random bytes, base64url.
SESSION_SECRET=
# NOTE_KEK: base64 of 32 random bytes; wraps each client's note key.
NOTE_KEK=
# NOTE_KEK_PREVIOUS: the NOTE_KEK a rotation retires, set only until keys.rewrap has moved every key; leave empty.
NOTE_KEK_PREVIOUS=
# SETUP_TOKEN: one time; lets /setup create the first admin on an empty database. Delete it after the claim.
SETUP_TOKEN=
# BACKUP_RECIPIENT: the age public key (age1...) the nightly backup is encrypted to; its identity stays offline.
# `just gen-test-keys` writes a dummy pair under test/fixtures/ for local use.
BACKUP_RECIPIENT=
# The off-account copy (BACKUP_COPY s3 in wrangler.jsonc): the S3 API endpoint (an https:// origin), the bucket
# in the second account, and an access key scoped to that one bucket. Local dev and tests leave all four empty.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
# DEMO_BANNER: "on" opens every page with a line saying it is a demo of invented data. Leave it empty (off) for
# anything but a demo; wrangler.jsonc sets it only in the demo environment.
DEMO_BANNER=
# MCP: "on" opens /mcp for agent clients (Claude and others). Leave it empty (off) and every agent route is a 404.
MCP=
# MCP_NOTES: "read" lets an agent read note text, which then reaches its provider; empty (off) gives it has_note only.
MCP_NOTES=
# MCP_CLIENTS: https redirect-URI prefixes, comma separated and each ending in a slash, of hosted clients allowed to ask
# for access besides claude.ai and a program on the same machine. Empty allows only those two.
MCP_CLIENTS=
# SSO_PROVIDERS: a JSON array of identity providers to sign in with besides passkeys, one entry per tenant, each
# {"id","label","issuer","client_id"} (the Google preset is {"id":"google","client_id":"..."}); each needs a secret
# SSO_SECRET_<ID> (id upper-cased, "-" as "_"). Empty (off) and every /auth/sso route is a 404.
SSO_PROVIDERS=
