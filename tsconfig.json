{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "src/pages/.well-known/**/*",
    "test/**/*",
    "e2e/**/*",
    "scripts/**/*",
    "*.ts",
    "*.mjs"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  }
}
