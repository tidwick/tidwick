  {
    "name": "submit_week",
    "title": "Submit a week",
    "description": "Submit your week for approval, which locks it until an accountant returns it. Call it without confirm for a summary and a confirm value, then again with that value to submit; an edit in between makes the confirm stale.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "weekStart": {
          "type": "string",
          "description": "The Monday the week starts on, as YYYY-MM-DD"
        },
        "confirm": {
          "description": "The confirm value from the first call",
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "weekStart"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "submitted": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "draft",
            "submitted",
            "approved",
            "returned"
          ]
        },
        "summary": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "integer"
            },
            "totalHundredths": {
              "type": "integer"
            },
            "dayHundredths": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          "required": [
            "rows",
            "totalHundredths",
            "dayHundredths"
          ]
        },
        "confirm": {
          "type": "string"
        }
      },
      "required": [
        "submitted",
        "state",
        "summary"
      ]
    },
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": false,
      "destructiveHint": true
    }
  }
