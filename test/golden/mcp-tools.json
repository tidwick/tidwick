[
  {
    "name": "list_projects",
    "title": "List projects",
    "description": "The projects and tasks you may add as a row to a week: your assigned projects with their live tasks.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string"
              },
              "client": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "taskCodeId": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "taskCodeId",
                    "code",
                    "name"
                  ]
                }
              }
            },
            "required": [
              "projectId",
              "client",
              "project",
              "tasks"
            ]
          }
        }
      },
      "required": [
        "projects"
      ]
    },
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "get_week",
    "title": "Get a week",
    "description": "Your rows and the cells with hours in them for one week, and whether the week is draft, submitted, approved or returned.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "weekStart": {
          "type": "string",
          "description": "The Monday the week starts on, as YYYY-MM-DD"
        }
      },
      "required": [
        "weekStart"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "weekStart": {
          "type": "string"
        },
        "state": {
          "enum": [
            "draft",
            "submitted",
            "approved",
            "returned"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rowId": {
                "type": "string"
              },
              "client": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "projectId": {
                "type": "string"
              },
              "taskCode": {
                "type": "string"
              },
              "task": {
                "type": "string"
              },
              "removable": {
                "type": "boolean"
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "day": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "hundredths": {
                      "type": "integer"
                    },
                    "has_note": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "day",
                    "hundredths",
                    "has_note"
                  ]
                }
              }
            },
            "required": [
              "rowId",
              "client",
              "project",
              "projectId",
              "taskCode",
              "task",
              "removable",
              "cells"
            ]
          }
        }
      },
      "required": [
        "weekStart",
        "state",
        "rows"
      ]
    },
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "save_entries",
    "title": "Save hours",
    "description": "Set hours for days of your own week. Each cell replaces what is stored for that row and day; a note you leave out is kept. A locked week refuses.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "weekStart": {
          "type": "string",
          "description": "The Monday the week starts on, as YYYY-MM-DD"
        },
        "cells": {
          "minItems": 1,
          "maxItems": 350,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rowId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "day": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6,
                "description": "Monday is 0, Sunday is 6"
              },
              "hours": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 32
                  },
                  {
                    "type": "number"
                  }
                ],
                "description": "Hours for the day as a decimal such as 7.5; 0 clears it"
              },
              "note": {
                "description": "Left out, the stored note is kept; an empty string clears it",
                "type": "string"
              }
            },
            "required": [
              "rowId",
              "day",
              "hours"
            ]
          }
        }
      },
      "required": [
        "weekStart",
        "cells"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "weekStart": {
          "type": "string"
        },
        "state": {
          "enum": [
            "draft",
            "submitted",
            "approved",
            "returned"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rowId": {
                "type": "string"
              },
              "client": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "projectId": {
                "type": "string"
              },
              "taskCode": {
                "type": "string"
              },
              "task": {
                "type": "string"
              },
              "removable": {
                "type": "boolean"
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "day": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "hundredths": {
                      "type": "integer"
                    },
                    "has_note": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "day",
                    "hundredths",
                    "has_note"
                  ]
                }
              }
            },
            "required": [
              "rowId",
              "client",
              "project",
              "projectId",
              "taskCode",
              "task",
              "removable",
              "cells"
            ]
          }
        }
      },
      "required": [
        "weekStart",
        "state",
        "rows"
      ]
    },
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
